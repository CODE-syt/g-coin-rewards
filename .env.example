# ============================================================================
# G Coin Rewards - environment configuration
# Copy to .env (never commit .env) and fill in. Generate secrets with:  npm run gen-secrets
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development                 # production in live deployments
PORT=3000
# Public base URL users reach the site on. Used for OAuth redirects and share links.
#   local:      http://localhost:3000
#   ngrok:      https://<your-subdomain>.ngrok-free.app   (see README "ngrok")
#   production: https://rewards.example.com                (must be https)
PUBLIC_URL=http://localhost:3000
# Extra browser origins allowed to call the API (comma-separated). Normally leave empty.
ALLOWED_ORIGINS=
# Set when behind a reverse proxy / load balancer / ngrok so client IPs and https are detected.
# 1 = one proxy hop (typical). Leave empty when running with no proxy.
TRUST_PROXY=

# --- MongoDB ----------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/gcoin
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gcoin?retryWrites=true&w=majority
MONGODB_URI=
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# --- Secrets (REQUIRED) -----------------------------------------------------
# >= 32 random characters. Signs session cookies.
SESSION_SECRET=replace-with-output-of-npm-run-gen-secrets
# 32 random bytes, base64. Encrypts voucher codes and admin MFA secrets at rest.
# BACK THIS UP: if it is lost, stored voucher codes can no longer be decrypted.
DATA_ENCRYPTION_KEY=replace-with-output-of-npm-run-gen-secrets

# --- Google sign-in (OAuth 2.0) ---------------------------------------------
# Required in production. Authorized redirect URI must be exactly:
#   ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Local-only shortcut that signs in any email without Google. Ignored/refused in production.
ENABLE_DEV_LOGIN=false

# --- Sessions ---------------------------------------------------------------
USER_SESSION_HOURS=168               # customer sessions (7 days, sliding)
ADMIN_IDLE_MINUTES=30                # admin session idle timeout
ADMIN_ABSOLUTE_HOURS=8               # admin must sign in again after this, no matter what

# --- Admin security ---------------------------------------------------------
ADMIN_REQUIRE_MFA=false              # true = admins must enroll an authenticator app to use the panel
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15

# --- Share & Earn rules -----------------------------------------------------
SHARE_REQUIRE_VISIT=true             # true: bonus is paid when a different device opens the link (recommended)
                                     # false: user confirms the share (after SHARE_MIN_DELAY_SECONDS)
SHARE_MIN_DELAY_SECONDS=15
SHARE_DAILY_BONUS_LIMIT=3            # max share bonuses per user per day
SHARE_DAY_TIMEZONE=UTC               # e.g. Asia/Kolkata

# --- AI chatbot -------------------------------------------------------------
CHATBOT_ENABLED=true                 # false removes the assistant from the UI and API
AI_PROVIDER=anthropic                # anthropic | openai | gemini  (openai also covers OpenAI-compatible APIs)
AI_API_KEY=                          # leave empty to use the built-in rule-based assistant only
AI_MODEL=                            # optional; default depends on provider
AI_BASE_URL=                         # optional; custom endpoint / proxy / OpenAI-compatible host
AI_TIMEOUT_MS=15000
CHAT_MAX_INPUT_CHARS=500
CHAT_RATE_LIMIT_PER_MIN=10
CHAT_DAILY_LIMIT=100                 # messages per user (or IP) per day

# --- Tests only -------------------------------------------------------------
# Database name MUST contain "test": the suite wipes it.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/gcoin_test
